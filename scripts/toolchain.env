# Single source of truth for WHICH container image is the reference environment.
# Sourced by scripts/setup.sh and read by the GitHub Actions workflows, so that
# the image reference exists in exactly one place -- same reasoning as
# qemu-flags.sh applies to flags.

IMAGE_REGISTRY="ghcr.io"
IMAGE_OWNER="ngelkind"
IMAGE_NAME="os-final-project-ci"

# The tag developers pull. CI pins jobs to the immutable commit-SHA tag
# instead, so that rebuilding the image can never change what an open pull
# request builds against. See docs/ci.md section 4, "How pinned is pinned".
IMAGE_TAG="${IMAGE_TAG:-latest}"

IMAGE="${IMAGE_REGISTRY}/${IMAGE_OWNER}/${IMAGE_NAME}:${IMAGE_TAG}"

# Platforms the image is published for. Multi-arch because the primary dev
# machine is Apple Silicon; see docs/ci.md section 5.
IMAGE_PLATFORMS="linux/amd64,linux/arm64"
